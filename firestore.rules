rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isSafeText(val) {
      // Basic check against script injection tags in user submissions
      return !(val.matches('.*<script.*') || val.matches('.*javascript:.*'));
    }

    // ─── 1. Public Read-Only Financial Collections ───────────────
    // Financial records, expenses, water supply, and settings can be viewed by all residents,
    // but CANNOT be tampered with or deleted by public users.
    match /monthly_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /water_supply/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── 2. WhatsApp Contacts Directory ──────────────────────────
    // Residents can read to match their profile. New residents can register their own contact.
    // Malicious users CANNOT wipe, batch-delete, or corrupt directory entries.
    match /whatsapp_contacts/{contactId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'phone'])
                    && isValidString(request.resource.data.name, 2, 80)
                    && isSafeText(request.resource.data.name)
                    && isValidString(request.resource.data.phone, 7, 25);
      allow update, delete: if request.auth != null;
    }

    // ─── 3. Visitor Tracking Analytics ───────────────────────────
    // Protected against tampering: Public can only insert a strictly validated visit log.
    // Hackers CANNOT delete, overwrite, or edit visitor logs.
    match /visitor_logs/{logId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'device', 'timestamp'])
                            && isValidString(request.resource.data.name, 1, 100)
                            && isSafeText(request.resource.data.name)
                            && request.resource.data.device in ['Mobile', 'Desktop']
                            && request.resource.data.timestamp is number;
      allow delete: if request.auth != null;
    }

    // ─── 4. Resident Feedback & Ratings ──────────────────────────
    // Public can submit feedback with strict validation (Rating 1-5, clean comments).
    // Hackers CANNOT delete or modify existing ratings or inject abusive payload.
    match /resident_feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['rating', 'timestamp'])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.timestamp is number
                    && (!('comment' in request.resource.data) || (
                        request.resource.data.comment is string 
                        && request.resource.data.comment.size() <= 1000
                        && isSafeText(request.resource.data.comment)
                      ));
      allow update, delete: if request.auth != null;
    }

    // ─── Default Fallback: Deny Everything Else ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
