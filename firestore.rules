rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isSafeText(val) {
      // Basic check against script injection tags in user submissions
      return !(val.matches('.*<script.*') || val.matches('.*javascript:.*'));
    }

    // ─── 1. Public Read & Admin Settings ──────────────────────────
    // Hardened setting rule: only document '1' can be written,
    // and adminPassword must be a safe string with minimum 6 characters.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if settingId == '1'
                    && (!('adminPassword' in request.resource.data) || (
                        request.resource.data.adminPassword is string 
                        && request.resource.data.adminPassword.size() >= 6 
                        && request.resource.data.adminPassword.size() <= 60
                    ));
    }

    // ─── 2. Financial Collections (Monthly Records & Expenses) ────
    // Validates structured data and safe text to prevent exploit payloads.
    match /monthly_records/{recordId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['month'])
                            && isValidString(request.resource.data.month, 3, 50)
                            && isSafeText(request.resource.data.month);
      allow delete: if true;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['amount'])
                            && request.resource.data.amount is number
                            && (!('name' in request.resource.data) || (
                                isValidString(request.resource.data.name, 1, 100)
                                && isSafeText(request.resource.data.name)
                            ));
      allow delete: if true;
    }

    // ─── 3. Water Supply Tracking ─────────────────────────────────
    match /water_supply/{entryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── 4. WhatsApp Contacts Directory ──────────────────────────
    match /whatsapp_contacts/{contactId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'phone'])
                            && isValidString(request.resource.data.name, 1, 80)
                            && isSafeText(request.resource.data.name)
                            && isValidString(request.resource.data.phone, 7, 25);
      allow delete: if true;
    }

    // ─── 5. Visitor Tracking Analytics ───────────────────────────
    match /visitor_logs/{logId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'device', 'timestamp'])
                            && isValidString(request.resource.data.name, 1, 100)
                            && isSafeText(request.resource.data.name)
                            && request.resource.data.device in ['Mobile', 'Desktop']
                            && request.resource.data.timestamp is number;
      allow delete: if true;
    }

    // ─── 6. Resident Feedback & Ratings ──────────────────────────
    match /resident_feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['rating', 'timestamp'])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.timestamp is number
                    && (!('comment' in request.resource.data) || (
                        request.resource.data.comment is string 
                        && request.resource.data.comment.size() <= 1000
                        && isSafeText(request.resource.data.comment)
                      ));
      allow update, delete: if true;
    }

    // ─── Default Fallback: Deny Everything Else ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
